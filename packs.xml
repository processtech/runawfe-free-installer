<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<izpack:installation version="5.0"
    xmlns:izpack="http://izpack.org/schema/installation"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://izpack.org/schema/installation http://izpack.org/schema/5.0/izpack-installation-5.0.xsd">

    <packs>

        <pack name="Серверные компоненты"
            required="no" installGroups="Администратор,Аналитик" condition="!Usertype.User">
            <description/>
        </pack>

        <pack name="RunaWFE сервер" required="yes" parent="Серверные компоненты" preselected="yes"
            installGroups="Администратор" condition="Usertype.Administrator">
            <file os="windows" src="resources\images\windows\Cs_20x20_256.ico"
                targetdir="$INSTALL_PATH/$images.subpath">
            </file>
            <file os="unix" src="resources\images\unix\Cs_20x20_256.png"
                targetdir="$INSTALL_PATH/$images.subpath">
            </file>
            <fileset dir="@{ENV[BUILD_ROOT]}\wfe-server-config\standalone\deployments"
                override="true"
                targetdir="$INSTALL_PATH\$server.subpath\standalone\deployments">
            </fileset>
            <fileset dir="@{ENV[BUILD_ROOT]}\wildfly\app-server\standalone\wfe.data-sources"
                override="true"
                targetdir="$INSTALL_PATH\$server.subpath\standalone\wfe.data-sources">
            </fileset>
            <file src="resources\wfe.custom.database.properties"
                targetdir="$INSTALL_PATH\$server.subpath\standalone\wfe.custom"
                override="true">
            </file>
            <parsable
                targetfile="$INSTALL_PATH\$server.subpath\standalone\wfe.custom\wfe.custom.database.properties"
                type="javaprop"/>
            <file src="runnable\remove_server_service.bat" override="true"
                targetdir="$INSTALL_PATH\$server.subpath">
            </file>
            <parsable
                targetfile="$INSTALL_PATH\$server.subpath\remove_server_service.bat"
                type="plain"/>
            <executable
                targetfile="$INSTALL_PATH\$server.subpath\remove_server_service.bat"
                type="bin" stage="uninstall" failure="ignore">
                <os family="windows"/>
            </executable>
            <description>Основной сервер, предназначенный для многопользовательской работы</description>
            <updatecheck>
                <include name="$server.subpath\standalone\wfe.custom\wfe.custom.installation.properties"/>
                <include name="$server.subpath\standalone\wfe.custom\wfe.custom.system.properties"/>
                <!-- При апдейте не удаляем ничего из папки wfe.custom, кроме свойств отправки статистики, если они не
                устанавливаются -->
            </updatecheck>
        </pack>

        <pack name="RunaWFE симулятор" required="no" parent="Серверные компоненты"
            installGroups="Аналитик" condition="Usertype.Analyst">
            <file os="windows" src="resources\images\windows\Si_20x20_256.ico"
                targetdir="$INSTALL_PATH/$images.subpath">
            </file>
            <file os="unix" src="resources\images\unix\Si_20x20_256.png"
                targetdir="$INSTALL_PATH/$images.subpath">
            </file>
            <file os="windows" src="runnable\simulator_install_cleanup.bat" override="true"
                targetdir="$INSTALL_PATH/$simulator.subpath">
            </file>
            <parsable
                targetfile="$INSTALL_PATH/$simulator.subpath/simulator_install_cleanup.bat"/>
            <executable
                targetfile="$INSTALL_PATH/$simulator.subpath/simulator_install_cleanup.bat"
                type="bin" stage="postinstall" failure="ignore">
                <os family="windows"/>
            </executable>
            <fileset dir="@{ENV[BUILD_ROOT]}\wfe-simulator" override="true"
                excludes="standalone\data\demo-db\**"
                targetdir="$INSTALL_PATH/$simulator.subpath">
            </fileset>
            <file os="windows" src="resources\simulator.html" override="true"
                targetdir="$INSTALL_PATH/$simulator.subpath">
            </file>
            <parsable targetfile="$INSTALL_PATH/$simulator.subpath/simulator.html"/>
            <file os="windows" src="runnable\run_simulaton.bat"
                targetdir="$INSTALL_PATH/$simulator.subpath/bin">
            </file>
            <parsable targetfile="$INSTALL_PATH/$simulator.subpath/bin/run_simulaton.bat"/>
            <file os="windows" src="runnable\stop_simulation.bat"
                targetdir="$INSTALL_PATH/$simulator.subpath/bin">
            </file>
            <parsable targetfile="$INSTALL_PATH/$simulator.subpath/bin/stop_simulation.bat"/>
            <description>
                Сервер-симулятор - адаптированная для для рабочей станции версия RunaWFE сервера. Предназначена для знакомства с системой, тестироваия и работы одного пользователя. Логин администратора по умолчанию - "Administrator", пароль - "wf".
            </description>
            <updatecheck>
                <exclude name="$java.subpath/**"/>
            </updatecheck>

        </pack>

        <pack name="Сервер приложений" parent="Серверные компоненты" hidden="true"
            condition="izpack.selected.RunaWFE симулятор|izpack.selected.RunaWFE сервер">
            <fileset dir="@{ENV[BUILD_ROOT]}\wfe-server-jboss" override="true"
                excludes="standalone\** bin\standalone.conf.bat"
                targetdir="$INSTALL_PATH/$appserver.subpath">
            </fileset>
            <fileset dir="@{ENV[BUILD_ROOT]}\jboss-native" override="true"
                targetdir="$INSTALL_PATH/$appserver.subpath/bin">
            </fileset>
            <fileset dir="@{ENV[BUILD_ROOT]}\wfe-server-jboss\standalone\configuration"
                override="true"
                excludes="standalone.xml"
                targetdir="$standalone.path\configuration">
            </fileset>
            <file src="resources\standalone.xml" override="true"
                targetdir="$standalone.path\configuration">
            </file>
            <parsable targetfile="$standalone.path\configuration\standalone.xml" type="ant"/>
            <fileset dir="@{ENV[BUILD_ROOT]}\wfe-server-jboss\standalone\deployments"
                override="true"
                targetdir="$standalone.path\deployments">
            </fileset>
            <file src="resources\standalone.conf.bat" override="true"
                targetdir="$INSTALL_PATH/$appserver.subpath/bin">
            </file>
            <parsable targetfile="$INSTALL_PATH/$appserver.subpath/bin/standalone.conf.bat" type="ant"/>
            <executable
                targetfile="$INSTALL_PATH\$server.subpath\bin\service.bat"
                condition="izpack.selected.RunaWFE сервер" keep="true"
                type="bin" stage="postinstall" failure="warn">
                <args>
                    <arg value="install"/>
                </args>
                <os family="windows"/>
            </executable>
            <description/>
        </pack>

        <pack name="Демо-конфигурация" required="no" parent="Серверные компоненты"
            installGroups="Аналитик"
            condition="Usertype.Analyst+izpack.selected.RunaWFE симулятор+!simulator.db.exists">
            <fileset dir="@{ENV[BUILD_ROOT]}\wfe-simulator\standalone\data\demo-db"
                override="true"
                targetdir="$standalone.path\data\demo-db">
            </fileset>
            <description>База данных с демонстрационными пользователями и процессами. Недоступна для установки, если база данных уже существует.</description>
            <updatecheck>
                <exclude name="$java.subpath/**"/>
            </updatecheck>
        </pack>

        <pack name="Отправка статистики" required="no" parent="Серверные компоненты"
            condition="izpack.selected.RunaWFE симулятор|izpack.selected.RunaWFE сервер">
            <file
                src="runnable\create_installation_props.ps1"
                targetdir="$INSTALL_PATH\$appserver.subpath\standalone\wfe.custom"/>
            <parsable
                targetfile="$INSTALL_PATH\$appserver.subpath\standalone\wfe.custom\create_installation_props.ps1"
                type="shell"/>
            <file
                src="runnable\create_installation_props.cmd"
                targetdir="$INSTALL_PATH\$appserver.subpath\standalone\wfe.custom"/>
            <executable
                targetfile="$INSTALL_PATH\$appserver.subpath\standalone\wfe.custom\create_installation_props.cmd"
                stage="postinstall"
                os="windows">
            </executable>
            <file
                src="resources\wfe.custom.system.properties"
                targetdir="$INSTALL_PATH\$appserver.subpath\standalone\wfe.custom"/>
            <description>Сообщать техническую информацию о работе системы. Эти данные требуются нам для развития и улучшения системы.</description>
        </pack>

        <pack name="Среда разработки" required="no" preselected="yes"
            installGroups="Аналитик" condition="Usertype.Analyst">
            <file os="windows" src="resources\images\windows\e_20x20_256.ico"
                targetdir="$INSTALL_PATH/$images.subpath">
            </file>
            <file os="unix" src="resources\images\unix\e_20x20_256.png"
                targetdir="$INSTALL_PATH/$images.subpath">
            </file>
            <file os="windows" src="runnable\studio_install_cleanup.bat"
                targetdir="$INSTALL_PATH/$gpd.subpath">
            </file>
            <executable targetfile="$INSTALL_PATH/$gpd.subpath/studio_install_cleanup.bat"
                type="bin" stage="postinstall" failure="ignore">
                <os family="windows"/>
            </executable>
            <fileset dir="@{ENV[BUILD_ROOT]}\gpd\64\gpd-${WFE.version}" override="true"
                targetdir="$INSTALL_PATH/$gpd.subpath">
                <!-- Не устанавливаем демо-процессы в студию -->
                <exclude name="demo-workspace/**"/>
                <exclude name="runa-gpd.ini"/>
            </fileset>
            <file src="resources\runa-gpd.ini"
                targetdir="$INSTALL_PATH/$gpd.subpath" override="true">
            </file>
            <parsable targetfile="$INSTALL_PATH/$gpd.subpath/runa-gpd.ini"/>
            <description>Приложение, предназначенное для разработки процессов</description>
            <updatecheck>
                <exclude name="$java.subpath/**"/>
            </updatecheck>
        </pack>

        <pack name="Оповещаетель задач" required="no" preselected="no"
            installGroups="Пользователь,Аналитик" condition="!Usertype.Administrator">
            <file os="windows" src="resources\images\windows\t_20x20_256.ico"
                targetdir="$INSTALL_PATH/$images.subpath">
            </file>
            <file os="unix" src="resources\images\unix\t_20x20_256.png"
                targetdir="$INSTALL_PATH/$images.subpath">
            </file>
            <fileset dir="@{ENV[BUILD_ROOT]}\rtn-${WFE.version}\64" override="true"
                targetdir="$INSTALL_PATH/$rtn.subpath">
                <exclude name="run.bat"/>
            </fileset>
            <file os="windows" src="runnable\rtn.bat" override="true"
                targetdir="$INSTALL_PATH/$rtn.subpath">
            </file>
            <parsable targetfile="$INSTALL_PATH\$rtn.subpath\rtn.bat">
                <os family="windows"/>
            </parsable>
            <singlefile src="resources\rtn.properties" target="$USER_HOME\config.properties"
                override="askfalse">
            </singlefile>
            <parsable targetfile="$USER_HOME\config.properties" type="javaprop">
            </parsable>
            <description>
                Приложение, предназначенное для проверки новых задач пользователей. Для установки этого компонента вам потребуется адрес основного RunaWFE сервера (хост и порт). Возьмите его у вашего системного администратора, прежде чем продолжать установку.
            </description>
            <updatecheck>
                <exclude name="$java.subpath/**"/>
            </updatecheck>
        </pack>

        <pack name="Ярлык веб-интерфейса RunaWFE сервера" required="no" preselected="no"
            installGroups="Пользователь,Аналитик" condition="!Usertype.Administrator">
            <file os="windows" src="resources\images\windows\C_20x20_256.ico"
                targetdir="$INSTALL_PATH/$images.subpath">
            </file>
            <file os="unix" src="resources\images\unix\C_20x20_256.png"
                targetdir="$INSTALL_PATH/$images.subpath">
            </file>
            <file os="windows" src="resources\runawfe.html" override="true"
                targetdir="$INSTALL_PATH/$web.interface.subpath">
            </file>
            <parsable targetfile="$INSTALL_PATH/$web.interface.subpath/runawfe.html"/>
            <description>
                Ссылка на веб-интерфейс основного RunaWFE сервера. Для установки этого компонента вам потребуется адрес основного RunaWFE сервера (хост и порт). Возьмите его у вашего системного администратора, прежде чем продолжать установку. Далее можно будет выбрать создание ярлыка на рабочем столе и в главном меню.
            </description>
            <updatecheck>
                <exclude name="$java.subpath/**"/>
            </updatecheck>
        </pack>

        <pack name="Обязательные компоненты" hidden="true" required="yes">
            <file os="windows" src="resources\images\windows\wf_48x128.ico"
                targetdir="$INSTALL_PATH/$images.subpath">
            </file>
            <file os="unix" src="resources\images\unix\wf_48x128.png"
                targetdir="$INSTALL_PATH/$images.subpath">
            </file>
            <file src="properties" targetdir="$INSTALL_PATH" override="true"/>
            <parsable targetfile="$INSTALL_PATH/properties"/>
            <file os="windows" src="runnable\update_cleanup.bat" override="true"
                targetdir="$INSTALL_PATH">
            </file>
            <parsable targetfile="$INSTALL_PATH\update_cleanup.bat">
                <os family="windows"/>
            </parsable>
            <executable targetfile="$INSTALL_PATH\update_cleanup.bat"
                type="bin" stage="postinstall" failure="ignore">
                <os family="windows"/>
            </executable>
            <file os="windows" src="runnable\uninstall.bat" override="true"
                targetdir="$INSTALL_PATH\Uninstaller">
            </file>
            <parsable targetfile="$INSTALL_PATH\Uninstaller\uninstall.bat">
                <os family="windows"/>
            </parsable>
            <description></description>
        </pack>

    </packs>

</izpack:installation>