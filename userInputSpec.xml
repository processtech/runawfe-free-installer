<izpack:userinput version="5.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:izpack="http://izpack.org/schema/userinput"
    xsi:schemaLocation="http://izpack.org/schema/userinput http://izpack.org/schema/5.0/izpack-userinput-5.0.xsd">

    <panel id="panel.database.connection" topBuffer="0">
        <createForPack name="RunaWFE сервер"/>
        <field type="staticText" txt="Параметры подключения к базе данных"/>
        <field type="space"/>

        <field type="combo" variable="DBMS.type" conditionid="Usertype.Administrator">
            <spec txt="SQL сервер">
                <choice txt="PostgreSQL" value="PostgreSQL" set="true"/>
                <choice txt="MS SQL" value="MSSQL"/>
                <choice txt="Oracle" value="Oracle"/>
                <choice txt="H2" value="H2"/>
            </spec>
        </field>

        <field type="space"/>

        <field type="text" variable="DBMS.host" conditionid="!DBMS.H2">
            <spec size="30" txt="Хост" set="localhost"/>
            <validator class="com.izforge.izpack.panels.userinput.validator.NotEmptyValidator"
                txt="${host}: ${empty}"/>
        </field>

        <field type="space"/>

        <field type="rule" variable="DBMS.p" conditionid="DBMS.PostgreSQL">
            <spec layout="N:5:5" txt="${port}" default="5432">
                <processor class="com.izforge.izpack.panels.userinput.processor.PortProcessor"
                    toVariable="DBMS.port"/>
            </spec>
            <validator
                class="com.izforge.izpack.panels.userinput.validator.NotEmptyValidator"
                txt="${port}: ${empty}"/>
            <validator class="com.izforge.izpack.panels.userinput.validator.IsPortValidator"
                txt="${port}: ${port.invalid}"/>
        </field>
        <field type="rule" variable="DBMS.p" conditionid="DBMS.MSSQL">
            <spec layout="N:5:5" txt="${port}" default="1433">
                <processor class="com.izforge.izpack.panels.userinput.processor.PortProcessor"
                    toVariable="DBMS.port"/>
            </spec>
            <validator
                class="com.izforge.izpack.panels.userinput.validator.NotEmptyValidator"
                txt="${port}: ${empty}"/>
            <validator class="com.izforge.izpack.panels.userinput.validator.IsPortValidator"
                txt="${port}: ${port.invalid}"/>
        </field>
        <field type="rule" variable="DBMS.p" conditionid="DBMS.Oracle">
            <spec layout="N:5:5" txt="${port}" default="1521">
                <processor class="com.izforge.izpack.panels.userinput.processor.PortProcessor"
                    toVariable="DBMS.port"/>
            </spec>
            <validator
                class="com.izforge.izpack.panels.userinput.validator.NotEmptyValidator"
                txt="${port}: ${empty}"/>
            <validator class="com.izforge.izpack.panels.userinput.validator.IsPortValidator"
                txt="${port}: ${port.invalid}"/>
        </field>


        <field type="space"/>

        <field type="rule" variable="DBMS.dbname" conditionid="!DBMS.H2">
            <spec txt="Название базы данных" layout="O:29:30"/>
            <validator
                class="com.izforge.izpack.panels.userinput.validator.NotEmptyValidator"
                txt="Введите Название базы данных."/>
            <validator
                class="com.izforge.izpack.panels.userinput.validator.RegularExpressionValidator"
                txt="Недопустимое имя базы данных. Допустимые символы: буквы и цифры латинского алфавита, подчеркивание.">
                <param name="pattern" value="^[a-zA-Z][a-zA-Z0-9_]+$"/>
            </validator>
        </field>

        <field type="space"/>

        <field type="rule" variable="DBMS.user" conditionid="!DBMS.H2">
            <spec txt="Имя пользователя для СУБД" layout="O:29:30"/>
            <validator
                class="com.izforge.izpack.panels.userinput.validator.NotEmptyValidator"
                txt="Введите имя пользователя для управления СУБД."/>
            <validator
                class="com.izforge.izpack.panels.userinput.validator.RegularExpressionValidator"
                txt="Недопустимое имя пользователя. Допустимые символы: буквы и цифры латинского алфавита, подчеркивание.">
                <param name="pattern" value="^[a-zA-Z][a-zA-Z0-9_]+$"/>
            </validator>
        </field>

        <field type="space"/>
        <field type="divider" conditionid="!DBMS.H2"/>
        <field type="space"/>

        <field type="password" variable="DBMS.password" conditionid="!DBMS.H2">
            <spec>
                <pwd txt="Пароль" size="30"/>
                <pwd txt="Повторите пароль" size="30"/>
            </spec>
            <validator
                class="com.izforge.izpack.panels.userinput.validator.NotEmptyValidator"
                txt="Пароль не может быть пустым."/>
            <validator
                class="com.izforge.izpack.panels.userinput.validator.PasswordEqualityValidator"
                txt="Введенные пароли не совпадают."/>

        </field>
    </panel>

    <panel id="panel.wildfly.connection">
        <createForPack name="RunaWFE сервер"/>
        <createForPack name="RunaWFE симулятор"/>
        <field type="staticText" txt="Настройки сервера приложений Wildfly"/>

        <field type="rule" variable="default.jboss.management.http.port">
            <spec txt="${management.http.port}" default="9990" layout="N:5:5">
                <processor class="com.izforge.izpack.panels.userinput.processor.PortProcessor"
                    toVariable="jboss.management.http.port"/>
            </spec>
            <validator
                class="com.izforge.izpack.panels.userinput.validator.NotEmptyValidator"
                txt="${management.http.port}: ${empty}"/>
            <validator class="com.izforge.izpack.panels.userinput.validator.IsPortValidator"
                txt="${management.http.port}: ${port.invalid}"/>
        </field>

        <field type="rule" variable="default.jboss.management.https.port">
            <spec txt="${management.https.port}" default="9993" layout="N:5:5">
                <processor class="com.izforge.izpack.panels.userinput.processor.PortProcessor"
                    toVariable="jboss.management.https.port"/>
            </spec>
            <validator
                class="com.izforge.izpack.panels.userinput.validator.NotEmptyValidator"
                txt="${management.https.port}: ${empty}"/>
            <validator class="com.izforge.izpack.panels.userinput.validator.IsPortValidator"
                txt="${management.https.port}: ${port.invalid}"/>
        </field>

        <field type="rule" variable="default.jboss.ajp.port">
            <spec txt="${ajp.port}" default="8009" layout="N:5:5">
                <processor class="com.izforge.izpack.panels.userinput.processor.PortProcessor"
                    toVariable="jboss.ajp.port"/>
            </spec>
            <validator
                class="com.izforge.izpack.panels.userinput.validator.NotEmptyValidator"
                txt="${ajp.port}: ${empty}"/>
            <validator class="com.izforge.izpack.panels.userinput.validator.IsPortValidator"
                txt="${ajp.port}: ${port.invalid}"/>
        </field>

        <field type="rule" variable="default.jboss.http.port">
            <spec txt="${http.port}" default="8080" layout="N:5:5">
                <processor class="com.izforge.izpack.panels.userinput.processor.PortProcessor"
                    toVariable="jboss.http.port"/>
            </spec>
            <validator
                class="com.izforge.izpack.panels.userinput.validator.NotEmptyValidator"
                txt="${http.port}: ${empty}"/>
            <validator class="com.izforge.izpack.panels.userinput.validator.IsPortValidator"
                txt="${http.port}: ${port.invalid}"/>
        </field>

        <field type="rule" variable="default.jboss.https.port">
            <spec txt="${https.port}" default="8443" layout="N:5:5">
                <processor class="com.izforge.izpack.panels.userinput.processor.PortProcessor"
                    toVariable="jboss.https.port"/>
            </spec>
            <validator
                class="com.izforge.izpack.panels.userinput.validator.NotEmptyValidator"
                txt="${https.port}: ${empty}"/>
            <validator class="com.izforge.izpack.panels.userinput.validator.IsPortValidator"
                txt="${https.port}: ${port.invalid}"/>
        </field>

        <field type="rule" variable="default.jboss.iiop.port">
            <spec txt="${iiop.port}" default="3528" layout="N:5:5">
                <processor class="com.izforge.izpack.panels.userinput.processor.PortProcessor"
                    toVariable="jboss.iiop.port"/>
            </spec>
            <validator
                class="com.izforge.izpack.panels.userinput.validator.NotEmptyValidator"
                txt="${iiop.port}: ${empty}"/>
            <validator class="com.izforge.izpack.panels.userinput.validator.IsPortValidator"
                txt="${iiop.port}: ${port.invalid}"/>
        </field>

        <field type="rule" variable="default.jboss.iiop-ssl.port">
            <spec txt="${iiop-ssl.port}" default="3533" layout="N:5:5">
                <processor class="com.izforge.izpack.panels.userinput.processor.PortProcessor"
                    toVariable="jboss.iiop-ssl.port"/>
            </spec>
            <validator
                class="com.izforge.izpack.panels.userinput.validator.NotEmptyValidator"
                txt="${iiop-ssl.port}: ${empty}"/>
            <validator class="com.izforge.izpack.panels.userinput.validator.IsPortValidator"
                txt="${iiop-ssl.port}: ${port.invalid}"/>
        </field>

        <field type="rule" variable="default.jboss.txn-recovery-environment.port">
            <spec txt="${txn-recovery-environment.port}" default="4712" layout="N:5:5">
                <processor class="com.izforge.izpack.panels.userinput.processor.PortProcessor"
                    toVariable="jboss.txn-recovery-environment.port"/>
            </spec>
            <validator
                class="com.izforge.izpack.panels.userinput.validator.NotEmptyValidator"
                txt="${txn-recovery-environment.port}: ${empty}"/>
            <validator class="com.izforge.izpack.panels.userinput.validator.IsPortValidator"
                txt="${txn-recovery-environment.port}: ${port.invalid}"/>
        </field>

        <field type="rule" variable="default.jboss.txn-status-manager.port">
            <spec txt="${txn-status-manager.port}" default="4717" layout="N:5:5">
                <processor class="com.izforge.izpack.panels.userinput.processor.PortProcessor"
                    toVariable="jboss.txn-status-manager.port"/>
            </spec>
            <validator
                class="com.izforge.izpack.panels.userinput.validator.NotEmptyValidator"
                txt="${txn-status-manager.port}: ${empty}"/>
            <validator class="com.izforge.izpack.panels.userinput.validator.IsPortValidator"
                txt="${txn-status-manager.port}: ${port.invalid}"/>
        </field>

    </panel>

    <panel id="panel.port.changed.info">
        <createForPack name="RunaWFE сервер"/>
        <createForPack name="RunaWFE симулятор"/>
        <field type="title" txt="Изменение портов Wildfly" bold="true"/>
        <field type="staticText" txt="Некоторые из выбранных портов были заняты и автоматически изменены на свободные."/>
        <field type="space"/>
        <field type="staticText" txt="Список измененных портов:"/>
        <field type="space"/>
        <field type="staticText" conditionid="port.management.http.changed"
            txt="Порт HTTP управления: ${default.jboss.management.http.port} → ${jboss.management.http.port}"/>
        <field type="staticText" conditionid="port.management.https.changed"
            txt="Порт HTTPS управления: ${default.jboss.management.https.port} → ${jboss.management.https.port}"/>
        <field type="staticText" conditionid="port.ajp.changed"
            txt="Порт AJP подключения: ${default.jboss.ajp.port} → ${jboss.ajp.port}"/>
        <field type="staticText" conditionid="port.http.changed"
            txt="Основной HTTP порт: ${default.jboss.http.port} → ${jboss.http.port}"/>
        <field type="staticText" conditionid="port.https.changed"
            txt="Основной HTTPS порт: ${default.jboss.https.port} → ${jboss.https.port}"/>
        <field type="staticText" conditionid="port.iiop.changed"
            txt="Порт IIOP (незащищённый): ${default.jboss.iiop.port} → ${jboss.iiop.port}"/>
        <field type="staticText" conditionid="port.iiop-ssl.changed"
            txt="Порт IIOP с SSL: ${default.jboss.iiop-ssl.port} → ${jboss.iiop-ssl.port}"/>
        <field type="staticText" conditionid="port.txn-recovery.changed"
            txt="Порт восстановления транзакций: ${default.jboss.txn-recovery-environment.port} → ${jboss.txn-recovery-environment.port}"/>
        <field type="staticText" conditionid="port.txn-status.changed"
            txt="Порт менеджера статусов транзакций: ${default.jboss.txn-status-manager.port} → ${jboss.txn-status-manager.port}"/>
        <field type="space"/>
        <field type="staticText" txt="Если вас не устраивает автоматический выбор, вы можете вернуться назад и указать другие  порты."/>
    </panel>

    <panel id="panel.server.web.interface">
        <createForPack name="Оповещатель задач"/>
        <createForPack name="Ярлык веб-интерфейса RunaWFE сервера"/>
        <field type="staticText" txt="Адрес основного RunaWFE сервера"/>

        <field type="space"/>

        <field type="text" variable="server.host">
            <spec size="30" txt="Хост"/>
            <validator class="com.izforge.izpack.panels.userinput.validator.NotEmptyValidator"
                txt="${host}: ${empty}"/>
        </field>

        <field type="space"/>

        <field type="rule" variable="server.web.port">
            <spec layout="N:5:5" txt="${port}" default="8080">
            </spec>
            <validator
                class="com.izforge.izpack.panels.userinput.validator.NotEmptyValidator"
                txt="${port}: ${empty}"/>
            <validator class="com.izforge.izpack.panels.userinput.validator.IsPortValidator"
                txt="${port}: ${port.invalid}"/>
        </field>
    </panel>

    <panel id="panel.webkit.warn">
        <createForPack name="Среда разработки"/>
        <createForPack name="Оповещатель задач"/>
        <field type="title" txt="Предупреждение" bold="true"/>
        <field type="staticText" txt="Библиотека libwebkit2gtk-4.0.so.37 не найдена."/>
        <field type="staticText" txt="Она необходима для работы устанавливаемых компонентов."/>
        <field type="staticText" txt="Установите её до запуска Среды разработки или Нотификатора задач."/>
    </panel>

    <panel id="panel.gtk.warn">
        <createForPack name="Оповещатель задач"/>
        <field type="title" txt="Предупреждение" bold="true"/>
        <field type="staticText" txt="Библиотека libgtk2 не найдена."/>
        <field type="staticText" txt="Она необходима для работы нотификатора задач."/>
        <field type="staticText" txt="Установите пакет libgtk2 до запуска Нотификатора задач."/>
    </panel>

</izpack:userinput>