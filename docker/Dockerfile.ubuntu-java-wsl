FROM ubuntu:22.04

# Switch off interactive requests for installation
ENV DEBIAN_FRONTEND=noninteractive

# Install JDK and libraries required for GUI mode
RUN apt-get update && apt-get install -y \
    openjdk-11-jre \
    libx11-6 \
    libxext6 \
    libxrender1 \
    libxtst6 \
    libxi6 \
    libfreetype6 \
    fontconfig \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /installer