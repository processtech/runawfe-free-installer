<izpack:langpack version="5.0" xmlns:izpack="http://izpack.org/schema/langpack"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://izpack.org/schema/langpack http://izpack.org/schema/5.0/izpack-langpack-5.0.xsd">

    <str id="installer.reversetitle" txt="Установка $APP_NAME $APP_VER"/>
    <str id="installer.madewith" txt=""/>
    <str id="HelloPanel.url" txt="Сайт проекта: "/>
    <str id="HTMLLicencePanel.info" txt="Перед установкой ознакомьтесь с лицензионным соглашением:"/>
    <str id="LicencePanel.agree" txt="Я принимаю условия соглашения"/>
    <str id="LicencePanel.notagree" txt="Я не принимаю условия соглашения"/>
    <str id="InstallationGroupPanel.colNameSelected" txt="Выберите тип установки"/>
    <str id="InstallationGroupPanel.colNameSize" txt="Размер файлов"/>
    <str id="InstallationGroupPanel.description.Администратор" txt="Установка выделенного сервера для использования по сети"/>
    <str id="InstallationGroupPanel.description.Аналитик" txt="Возможность установки на данную рабочую станцию сервера-симулятора и клиентских приложений"/>
    <str id="InstallationGroupPanel.description.Пользователь" txt="Установка оповещателя задач и ссылки на сервер"/>
    <str id="ShortcutPanel.regular.create" txt="Создать ярлыки в главном меню"/>
    <str id="ShortcutPanel.regular.startup" txt="Запускать при старте компьютера"/>
    <str id="ShortcutPanel.regular.list" txt="Группа для создания ярлыков:"/>
    <str id="ShortcutPanel.regular.userIntro" txt="для пользователей:"/>
    <str id="ShortcutPanel.regular.default" txt="Вернуть группу по умолчанию"/>

    <!-- Heading strings -->
    <str id="HelloPanel.headline" txt=""/>
    <str id="CompilePanel.headline" txt="Compile Java Sources"/>
    <str id="FinishPanel.headline" txt="Installation Finished"/>
    <str id="HTMLLicencePanel.headline" txt=""/>
    <str id="InstallPanel.headline" txt=""/>
    <str id="InstallationGroupPanel.headline" txt=""/>
    <str id="ProcessPanel.headline" txt=""/>
    <str id="ShortcutPanel.headline" txt=""/>
    <str id="SimpleFinishPanel.headline" txt=""/>
    <str id="TargetPanel.headline" txt=""/>
    <str id="TreePacksPanel.headline" txt=""/>
    <str id="UserInputPanel.headline" txt=""/>
    <str id="InfoPanel.headline" txt=""/>

    <!-- PacksPanel strings -->
    <str id="PacksPanel.info" txt="Выберите компоненты для установки"/>
    <str id="PacksPanel.tip" txt="Установленные ранее, но невыбранные компоненты будут удалены"/>

    <!-- InfoPanel strings -->
    <str id="InfoPanel.info" txt="Внимание:"/>

    <!-- ProcessPanel strings -->
    <str id="ProcessPanel.heading" txt="Завершение установки"/>

    <!-- General installer strings -->
    <str id="installer.error" txt="Ошибка"/>
    <str id="installer.close" txt="Закрыть"/>

    <str id="data.validation.error.title" txt="Проблема"/>
    <str id="conditionvalidator.not.downgrade.error.message"
        txt="В даной папке обнаружена более поздняя версия приложения. Если вы хотите установить более раннюю версию, удалите полностью текущую."/>
    <str id="conditionvalidator.components.selected.error.message" txt="Выберите компоненты для установки."/>

    <!-- Lock File strings -->
    <str id="LockFile.exists.message"
        txt="Инсталлятор &quot;$APP_NAME&quot;, который вы пытаетесь запустить, возможно, уже запущен. Это может быть из-за предыдущей неудачной попытки установки или вы случайно запустили инсталлятор дважды. Рекомендуется подождать, пока другой экземпляр инсталлятора запустится. Если вы уверены, что другой копии инсталлятора не запущено, вы можете удалить файл блокировки &quot;$LOCK_FILE&quot; и перезапустить инсталлятор."/>
    <str id="LockFile.exists.prompt"
        txt="Инсталлятор &quot;$APP_NAME&quot;, который вы пытаетесь запустить, возможно, уже запущен.&#10;&#10;Это может быть из-за предыдущей неудачной попытки установки или вы случайно запустили&#10;инсталлятор дважды. Рекомендуется выбрать 'Нет' и подождать, пока другой экземпляр&#10;инсталлятора запустится. Если вы уверены, что другой копии инсталлятора не запущено, нажмите&#10;кнопку 'Да', чтобы разрешить запуск этого инсталлятора.&#10;&#10;Вы уверены, что хотите продолжить установку?"/>

</izpack:langpack>