<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<izpack:installation version="5.0"
    xmlns:izpack="http://izpack.org/schema/installation"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://izpack.org/schema/installation http://izpack.org/schema/5.0/izpack-installation-5.0.xsd">

    <installerrequirements>
        <installerrequirement condition="!is.downgrade"
            message="На данном компьютере уже установлена более поздняя версия приложения. Если вы хотите установить более раннюю версию, удалите полностью текущую."/>
    </installerrequirements>

    <natives>
        <native type="izpack" name="ShellLink.dll"/>
        <native type="izpack" name="ShellLink_x64.dll"/>
        <native type="3rdparty" name="COIOSHelper.dll" stage="both">
            <os family="windows"/>
        </native>
        <native type="3rdparty" name="COIOSHelper_x64.dll" stage="both">
            <os family="windows"/>
        </native>
    </natives>

    <listeners>
        <listener classname="RegistryInstallerListener" stage="install">
            <os family="windows"/>
        </listener>
        <listener classname="RegistryUninstallerListener" stage="uninstall">
            <os family="windows"/>
        </listener>
    </listeners>

    <info>
        <appname>RunaWFE_test</appname>
        <appversion>@{ENV[WFE_EDITION]}</appversion>
        <url>https://runawfe.ru/RunaWFE</url>
        <requiresjdk>no</requiresjdk>
        <writeinstallationinformation>yes</writeinstallationinformation>
        <run-privileged uninstaller="yes"/>
    </info>

    <guiprefs height="480" resizable="no" width="640">
        <modifier key="useButtonIcons" value="no"/>
        <modifier key="useLabelIcons" value="no"/>
        <modifier key="useFlags" value="no"/>
        <modifier key="useHeadingPanel" value="yes"/>
        <modifier key="headingImageOnLeft" value="yes"/>
        <modifier key="headingBackgroundColor" value="0x00ffffff"/>
    </guiprefs>

    <locale>
        <langpack iso3="rus"/>
    </locale>

    <resources>
        <res id="packsLang.xml" src="CustomLangPack.xml"/>
        <res id="CustomLangPack.xml_rus" src="CustomLangPack.xml_rus"/>
        <res id="HTMLLicencePanel.license" src="resources/License.html"/>
        <res id="Win_shortcutSpec.xml" src="win_shortcutSpec.xml"/>
        <res id="Heading.image"
            src="resources\images\big_logo.bmp"/>
        <res id="JFrameIcon" src="resources/images/Installer_16.png"/>
        <res id="customicons.xml" src="customicons.xml"/>
        <res id="userInputSpec.xml" src="userInputSpec.xml"/>
    </resources>

    <variables>
        <variable name="WFE.version" value="@{ENV[WFE_VERSION]}"/>
        <variable name="empty" value="значение не может быть пустым."/>
        <variable name="port.invalid"
            value="указанный адрес не существует. Значение долнжно быть в интервале от 0 до 65535."/>
        <variable name="host" value="Хост"/>
        <variable name="port" value="Порт"/>
        <variable name="management.http.port" value="Порт HTTP‑управления"/>
        <variable name="management.https.port" value="Порт HTTPS‑управления"/>
        <variable name="ajp.port" value="Порт AJP‑подключения"/>
        <variable name="http.port" value="Основной HTTP‑порт"/>
        <variable name="https.port" value="Основной HTTPS‑порт"/>
        <variable name="iiop.port" value="Порт IIOP (незащищённый)"/>
        <variable name="iiop-ssl.port" value="Порт IIOP с SSL"/>
        <variable name="txn-recovery-environment.port" value="Порт восстановления транзакций"/>
        <variable name="txn-status-manager.port" value="Порт статуса транзакций"/>
        <variable name="InstallationGroupPanel.sortKey.Аналитик" value="A"/>
        <variable name="InstallationGroupPanel.sortKey.Администратор" value="B"/>
        <variable name="InstallationGroupPanel.sortKey.Пользователь" value="C"/>
        <variable name="images.subpath" value="images"/>
        <variable name="web.interface.subpath" value="web"/>
        <variable name="simulator.subpath" value="simulator"/>
        <variable name="gpd.subpath" value="gpd"/>
        <variable name="rtn.subpath" value="rtn"/>
    </variables>


    <dynamicvariables>
        <variable name="installed.version" checkonce="true"
            file="${DEFAULT_INSTALL_PATH}/properties"
            key="WFE.version"/>
        <variable name="installed.version" condition="install.path.set"
            file="${INSTALL_PATH}/properties"
            key="WFE.version"/>
        <variable name="appdata" condition="izpack.windowsinstall"
            environment="APPDATA"
            checkonce="true"/>
        <variable name="appdata" condition="izpack.linuxinstall"
            environment="XDG_DATA_HOME"
            checkonce="true"/>
        <variable name="delete.gpd" condition="izpack.selected.Среда разработки"
            value="false"/>
        <variable name="delete.gpd" condition="!izpack.selected.Среда разработки"
            value="true"/>
        <variable name="delete.rtn" condition="izpack.selected.Оповещаетель задач"
            value="false"/>
        <variable name="delete.rtn" condition="!izpack.selected.Оповещаетель задач"
            value="true"/>
        <variable name="appserver.subpath" condition="izpack.selected.RunaWFE симулятор"
            value="$simulator.subpath"/>
    </dynamicvariables>

    <conditions>
        <condition type="exists" id="install.path.set">
            <variable>
                INSTALL_PATH
            </variable>
        </condition>

        <condition type="compareversions" id="is.downgrade">
            <arg1>${installed.version}</arg1>
            <arg2>${WFE.version}</arg2>
            <operator>gt</operator>
        </condition>

        <condition type="not" id="conditionvalidator.not.downgrade">
            <condition type="ref" refid="is.downgrade"/>
        </condition>

        <condition type="or" id="conditionvalidator.components.selected">
            <condition type="ref" refid="izpack.selected.RunaWFE сервер"/>
            <condition type="ref" refid="izpack.selected.RunaWFE симулятор"/>
            <condition type="ref" refid="izpack.selected.Демо-пользователи"/>
            <condition type="ref" refid="izpack.selected.Демо-процессы"/>
            <condition type="ref" refid="izpack.selected.Среда разработки"/>
            <condition type="ref" refid="izpack.selected.Оповещаетель задач"/>
            <condition type="ref" refid="izpack.selected.Ярлык веб-интерфейса RunaWFE сервера"/>
        </condition>

        <condition type="variable" id="DBMS.H2">
            <name>DBMS.type</name>
            <value>H2</value>
        </condition>
        <condition type="variable" id="DBMS.PostgreSQL">
            <name>DBMS.type</name>
            <value>PostgreSQL</value>
        </condition>
        <condition type="variable" id="DBMS.MSSQL">
            <name>DBMS.type</name>
            <value>MSSQL</value>
        </condition>
        <condition type="variable" id="DBMS.Oracle">
            <name>DBMS.type</name>
            <value>Oracle</value>
        </condition>

        <condition type="variable" id="Usertype.Administrator">
            <name>INSTALL_GROUP</name>
            <value>Администратор</value>
        </condition>
        <condition type="variable" id="Usertype.User">
            <name>INSTALL_GROUP</name>
            <value>Пользователь</value>
        </condition>
        <!-- workaround для preselect студии -->
        <condition type="and" id="Usertype.Analyst">
            <condition type="ref" refid="!Usertype.Administrator"/>
            <condition type="ref" refid="!Usertype.User"/>
        </condition>
    </conditions>

    <panels>
        <panel classname="HelloPanel"/>
        <panel classname="HTMLLicencePanel" id="license">
            <configuration>
                <param name="console-text-paging" value="true"/>
                <param name="console-text-wordwrap" value="true"/>
            </configuration>
        </panel>
        <panel classname="InstallationGroupPanel"/>
        <panel classname="TreePacksPanel">
            <validator classname="com.izforge.izpack.installer.validator.ConditionValidator"/>
        </panel>
        <panel classname="UserInputPanel" id="panel.database.connection"/>
        <panel classname="UserInputPanel" id="panel.wildfly.connection"/>
        <panel classname="UserInputPanel" id="panel.server.web.interface"/>
        <panel classname="UserInputPanel" id="panel.feedback"/>
        <panel classname="TargetPanel">
            <validator classname="com.izforge.izpack.installer.validator.ConditionValidator"/>
        </panel>
        <panel classname="InstallPanel"/>
        <panel classname="ShortcutPanel"/>
        <panel classname="SimpleFinishPanel"/>
    </panels>

    <packs>

        <pack name="Серверные компоненты"
            required="no" installGroups="Администратор,Аналитик" condition="!Usertype.User">
            <description/>
        </pack>

        <pack name="RunaWFE сервер" required="yes" parent="Серверные компоненты" preselected="yes"
            installGroups="Администратор" condition="Usertype.Administrator">
            <file os="windows" src="resources\images\Cs_20x20_256.ico"
                targetdir="$INSTALL_PATH/$images.subpath">
            </file>
            <description>Основной сервер, предназначенный для многопользовательской работы</description>
            <updatecheck/>
        </pack>

        <pack name="RunaWFE симулятор" required="no" parent="Серверные компоненты"
            installGroups="Аналитик" condition="Usertype.Analyst">
            <file os="windows" src="resources\images\Si_20x20_256.ico"
                targetdir="$INSTALL_PATH/$images.subpath">
            </file>
            <file os="windows" src="runnable\delete_activemq_cache.bat"
                targetdir="$INSTALL_PATH/$simulator.subpath">
            </file>
            <parsable
                targetfile="$INSTALL_PATH/$simulator.subpath/delete_activemq_cache.bat"/>
            <executable
                targetfile="$INSTALL_PATH/$simulator.subpath/delete_activemq_cache.bat"
                type="bin" stage="postinstall">
                <os family="windows"/>
            </executable>
            <fileset dir="@{ENV[BUILD_ROOT]}\wfe-simulator" override="true"
                targetdir="$INSTALL_PATH/$simulator.subpath">
            </fileset>
            <file os="windows" src="resources\simulator.html"
                targetdir="$INSTALL_PATH/$simulator.subpath">
            </file>
            <parsable targetfile="$INSTALL_PATH/$simulator.subpath/simulator.html"/>
            <description>
                Сервер-симулятор - адаптированная для для рабочей станции версия RunaWFE сервера. Предназначена для знакомства с системой, тестироваия и работы одного пользователя.
            </description>
            <updatecheck/>
        </pack>

        <pack name="Сервер приложений" parent="Серверные компоненты" hidden="true"
            condition="izpack.selected.RunaWFE симулятор">
            <fileset dir="@{ENV[BUILD_ROOT]}\wfe-server-jboss" override="true"
                targetdir="$INSTALL_PATH/$appserver.subpath">
            </fileset>
            <fileset dir="@{ENV[BUILD_ROOT]}\jboss-native" override="true"
                targetdir="$INSTALL_PATH/$appserver.subpath/bin">
            </fileset>
            <description></description>
        </pack>

        <pack name="Демо-пользователи" required="no" parent="Серверные компоненты"
            installGroups="Аналитик" condition="Usertype.Analyst+izpack.selected.RunaWFE симулятор">
            <description></description>
            <updatecheck/>
        </pack>

        <pack name="Демо-процессы" required="no" parent="Серверные компоненты" preselected="no"
            installGroups="Аналитик" condition="Usertype.Analyst+izpack.selected.RunaWFE симулятор">
            <description></description>
            <updatecheck/>
        </pack>

        <pack name="Среда разработки" required="no" preselected="yes"
            installGroups="Аналитик" condition="Usertype.Analyst">
            <file os="windows" src="resources\images\e_20x20_256.ico"
                targetdir="$INSTALL_PATH/$images.subpath">
            </file>
            <file os="windows" src="runnable\delete_eclipse_userdir.bat"
                targetdir="$INSTALL_PATH/$gpd.subpath">
            </file>
            <executable targetfile="$INSTALL_PATH/$gpd.subpath/delete_eclipse_userdir.bat"
                type="bin" stage="postinstall">
                <os family="windows"/>
            </executable>
            <fileset dir="@{ENV[BUILD_ROOT]}\gpd\64\gpd-${WFE.version}" override="true"
                targetdir="$INSTALL_PATH/$gpd.subpath">
                <!-- Не устанавливаем демо-процессы в студию -->
                <exclude name="demo-workspace/**"/>
            </fileset>
            <description>Приложение, предназначенное для разработки процессов</description>
            <updatecheck/>
        </pack>

        <pack name="Оповещаетель задач" required="no" preselected="no"
            installGroups="Пользователь,Аналитик" condition="!Usertype.Administrator">
            <file os="windows" src="resources\images\t_20x20_256.ico"
                targetdir="$INSTALL_PATH/$images.subpath">
            </file>
            <fileset dir="@{ENV[BUILD_ROOT]}\rtn-${WFE.version}\64" override="true"
                targetdir="$INSTALL_PATH/$rtn.subpath">
                <exclude name="run.bat"/>
            </fileset>
            <file os="windows" src="runnable\rtn.bat"
                targetdir="$INSTALL_PATH/$rtn.subpath">
            </file>
            <parsable targetfile="$INSTALL_PATH\$rtn.subpath\rtn.bat">
                <os family="windows"/>
            </parsable>
            <singlefile src="resources\rtn.properties" target="$USER_HOME\config.properties"
                override="true">
            </singlefile>
            <parsable targetfile="$USER_HOME\config.properties" type="javaprop">
            </parsable>
            <description>
                Приложение, предназначенное для проверки новых задач пользователей. Для установки этого компонента вам потребуется адрес основного RunaWFE сервера (хост и порт). Возьмите его у вашего системного администратора, прежде чем продолжать установку.
            </description>
            <updatecheck/>
        </pack>

        <pack name="Ярлык веб-интерфейса RunaWFE сервера" required="no" preselected="no"
            installGroups="Пользователь,Аналитик" condition="!Usertype.Administrator">
            <file os="windows" src="resources\images\C_20x20_256.ico"
                targetdir="$INSTALL_PATH/$images.subpath">
            </file>
            <file os="windows" src="resources\runawfe.html"
                targetdir="$INSTALL_PATH/$web.interface.subpath">
            </file>
            <parsable targetfile="$INSTALL_PATH/$web.interface.subpath/runawfe.html"/>
            <description>
                Ссылка на веб-интерфейс основного RunaWFE сервера. Для установки этого компонента вам потребуется адрес основного RunaWFE сервера (хост и порт). Возьмите его у вашего системного администратора, прежде чем продолжать установку. Далее можно будет выбрать создание ярлыка на рабочем столе и в главном меню.
            </description>
            <updatecheck/>
        </pack>

        <pack name="Обязательные компоненты" hidden="true" required="yes">
            <file os="windows" src="resources\images\wf_48x128.ico"
                targetdir="$INSTALL_PATH/$images.subpath">
            </file>
            <file src="properties" targetdir="$INSTALL_PATH"/>
            <parsable targetfile="$INSTALL_PATH/properties"/>
            <file os="windows" src="runnable\cleanup_update.bat"
                targetdir="$INSTALL_PATH">
            </file>
            <parsable targetfile="$INSTALL_PATH\cleanup_update.bat">
                <os family="windows"/>
            </parsable>
            <executable targetfile="$INSTALL_PATH\cleanup_update.bat"
                type="bin" stage="postinstall" failure="ignore">
                <os family="windows"/>
            </executable>
            <description></description>
        </pack>

    </packs>

</izpack:installation>