<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<izpack:installation version="5.0"
    xmlns:izpack="http://izpack.org/schema/installation"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://izpack.org/schema/installation http://izpack.org/schema/5.0/izpack-installation-5.0.xsd">

    <jar src="custom/processors/custom-processors.jar"/>

    <installerrequirements>
        <installerrequirement condition="!is.downgrade"
            message="На данном компьютере уже установлена более поздняя версия приложения. Если вы хотите установить более раннюю версию, удалите полностью текущую."/>
        <installerrequirement condition="x86_64|amd64|aarch64"
            message="Установка возможна только на компьютеры с 64-битной архитектурой"/>
        <installerrequirement condition="@!izpack.linuxinstall || is.root"
            message="Для установки требуются права root. Запустите инсталлятор с помощью команды sudo."/>
    </installerrequirements>

    <natives>
        <native type="izpack" name="ShellLink.dll" uninstaller="true">
            <os family="windows"/>
        </native>
        <native type="izpack" name="ShellLink_x64.dll" uninstaller="true">
            <os family="windows"/>
        </native>
        <native type="3rdparty" name="COIOSHelper.dll" uninstaller="true">
            <os family="windows"/>
        </native>
        <native type="3rdparty" name="COIOSHelper_x64.dll" uninstaller="true">
            <os family="windows"/>
        </native>
    </natives>

    <listeners>
        <listener classname="RegistryInstallerListener" stage="install">
            <os family="windows"/>
        </listener>
        <listener classname="RegistryUninstallerListener" stage="uninstall">
            <os family="windows"/>
        </listener>
    </listeners>

    <info>
        <appname>@{ENV[WFE_APPNAME]}</appname>
        <appversion>@{ENV[WFE_EDITION]}</appversion>
        <url>https://runawfe.ru/RunaWFE</url>
        <requiresjdk>no</requiresjdk>
        <writeinstallationinformation>yes</writeinstallationinformation>
        <run-privileged uninstaller="yes"/>
    </info>

    <guiprefs height="480" resizable="no" width="640">
        <modifier key="useButtonIcons" value="no"/>
        <modifier key="useLabelIcons" value="no"/>
        <modifier key="useFlags" value="no"/>
        <modifier key="useHeadingPanel" value="yes"/>
        <modifier key="headingImageOnLeft" value="yes"/>
        <modifier key="headingBackgroundColor" value="0x00ffffff"/>
    </guiprefs>

    <locale>
        <langpack iso3="rus"/>
    </locale>

    <resources>
        <res id="packsLang.xml" src="CustomLangPack.xml"/>
        <res id="CustomLangPack.xml_rus" src="CustomLangPack.xml_rus"/>
        <res id="HTMLLicencePanel.license" src="resources/License.html"/>
        <res id="LicencePanel.license_txt" src="resources/License.txt"/>
        <res id="Win_shortcutSpec.xml" src="win_shortcutSpec.xml"/>
        <res id="Unix_shortcutSpec.xml" src="unix_shortcutSpec.xml"/>
        <res id="Heading.image"
            src="resources/images/big_logo.png"/>
        <res id="JFrameIcon" src="resources/images/Installer_16.png"/>
        <res id="customicons.xml" src="customicons.xml"/>
        <res id="userInputSpec.xml" src="userInputSpec.xml"/>
        <res id="InfoPanel.info" src="resources\need_reboot.txt"/>
        <res id="ProcessPanel.Spec.xml" src="ProcessPanel.Spec.xml"/>
    </resources>

    <properties>
        <property name="rtn.appname" value="runawfe-notifier-$wfe.edition"/>
    </properties>

    <variables>
        <variable name="WFE.version" value="@{ENV[WFE_VERSION]}"/>
        <variable name="target.arch" value="@{ENV[TARGET_ARCH]}"/>
        <variable name="TargetPanel.dir.windows" value="${DEFAULT_INSTALL_PATH} @{ENV[WFE_EDITION]}"/>
        <variable name="TargetPanel.dir.unix" value="/opt/${APP_NAME}-@{ENV[WFE_EDITION]}"/>
        <variable name="appdata.install.path" value="${appdata}$FILE_SEPARATOR${APP_NAME}-@{ENV[WFE_EDITION]}"/>
        <variable name="empty" value="значение не может быть пустым."/>
        <variable name="port.invalid"
            value="Указанный адрес не существует. Значение должно быть в интервале от 0 до 65535."/>
        <variable name="host" value="Адрес"/>
        <variable name="port" value="Порт"/>
        <variable name="management.http.port" value="Порт HTTP‑управления"/>
        <variable name="management.https.port" value="Порт HTTPS‑управления"/>
        <variable name="ajp.port" value="Порт AJP‑подключения"/>
        <variable name="http.port" value="Основной HTTP‑порт"/>
        <variable name="https.port" value="Основной HTTPS‑порт"/>
        <variable name="iiop.port" value="Порт IIOP (незащищённый)"/>
        <variable name="iiop-ssl.port" value="Порт IIOP с SSL"/>
        <variable name="txn-recovery-environment.port" value="Порт восстановления транзакций"/>
        <variable name="txn-status-manager.port" value="Порт статуса транзакций"/>
        <variable name="InstallationGroupPanel.sortKey.Аналитик" value="A"/>
        <variable name="InstallationGroupPanel.sortKey.Администратор" value="B"/>
        <variable name="InstallationGroupPanel.sortKey.Пользователь" value="C"/>
        <variable name="images.subpath" value="images"/>
        <variable name="web.interface.subpath" value="web"/>
        <variable name="simulator.subpath" value="simulator"/>
        <variable name="gpd.subpath" value="gpd"/>
        <variable name="rtn.subpath" value="rtn"/>
        <variable name="server.subpath" value="server"/>
        <variable name="java.subpath" value="java"/>
        <variable name="jboss.servicename" value="@{ENV[SVCNAME]}"/>
        <variable name="InfoPanel.font" value="Arial"/>
        <variable name="statistic.report.url" value="@{ENV[STATISTIC_REPORT_URL]}"/>
        <variable name="statistic.report.days.after.error"
            value="@{ENV[STATISTIC_REPORT_DAYS_AFTER_ERROR]}"/>
        <variable name="INSTALLER_EXE" value="@{ENV[INSTALLER_EXE]}"/>
        <variable name="DesktopShortcutCheckboxEnabled" value="true"/>
        <variable name="wfe.edition" value="@{ENV[WFE_EDITION]}"/>
        <variable name="ds.shortcut.name" value="Developer studio $wfe.edition"/>
        <variable name="rtn.shortcut.name" value="Task notifier $wfe.edition"/>
        <variable name="server.shortcut.name" value="Server web interface $wfe.edition"/>
        <variable name="simulator.shortcut.name" value="Simulator web interface $wfe.edition"/>
        <variable name="simstart.shortcut.name" value="Start simulation $wfe.edition"/>
        <variable name="simstop.shortcut.name" value="Stop simulation $wfe.edition"/>
        <variable name="uninstall.shortcut.name" value="Uninstall $APP_NAME $wfe.edition $WFE.version"/>
    </variables>


    <dynamicvariables>
        <variable name="installed.version" checkonce="true" condition="izpack.windowsinstall"
            file="${TargetPanel.dir.windows}/properties"
            key="WFE.version"/>
        <variable name="installed.version" checkonce="true" condition="izpack.linuxinstall"
            file="${TargetPanel.dir.unix}/properties"
            key="WFE.version"/>
        <variable name="installed.version" condition="install.path.set"
            file="${INSTALL_PATH}/properties"
            key="WFE.version"/>
        <variable name="appdata" condition="izpack.windowsinstall"
            environment="APPDATA"
            checkonce="true"/>
        <variable name="appdata" condition="izpack.linuxinstall+xdg.data.home.exists"
            environment="XDG_DATA_HOME"
            checkonce="true"/>
        <variable name="appdata" condition="izpack.linuxinstall+!xdg.data.home.exists"
            value="$HOME/.local/share"
            checkonce="true"/>
        <variable name="local.appdata" condition="izpack.windowsinstall"
            environment="LOCALAPPDATA"
            checkonce="true"/>
        <variable name="DBMS.type" condition="izpack.selected.RunaWFE симулятор"
            value="H2"/>
        <variable name="delete.gpd" condition="izpack.selected.Среда разработки"
            value="false"/>
        <variable name="delete.gpd" condition="!izpack.selected.Среда разработки"
            value="true"/>
        <variable name="delete.rtn" condition="izpack.selected.Оповещатель задач"
            value="false"/>
        <variable name="delete.rtn" condition="!izpack.selected.Оповещатель задач"
            value="true"/>
        <variable name="delete.simulator" condition="izpack.selected.RunaWFE симулятор"
            value="false"/>
        <variable name="delete.simulator" condition="!izpack.selected.RunaWFE симулятор"
            value="true"/>
        <variable name="appserver.subpath" condition="izpack.selected.RunaWFE симулятор"
            value="$simulator.subpath"/>
        <variable name="appserver.subpath" condition="izpack.selected.RunaWFE сервер"
            value="$server.subpath"/>
        <variable name="standalone.path" condition="izpack.selected.RunaWFE симулятор"
            value="$INSTALL_PATH$FILE_SEPARATOR$simulator.subpath${FILE_SEPARATOR}standalone"/>
        <variable name="standalone.path" condition="izpack.selected.RunaWFE сервер"
            value="$INSTALL_PATH$FILE_SEPARATOR$server.subpath${FILE_SEPARATOR}standalone"/>
        <variable name="hibernate.dialect" condition="DBMS.H2"
            value="org.hibernate.dialect.H2Dialect"/>
        <variable name="hibernate.dialect" condition="DBMS.PostgreSQL"
            value="org.hibernate.dialect.PostgreSQLDialect"/>
        <variable name="hibernate.dialect" condition="DBMS.MSSQL"
            value="ru.runa.wfe.commons.hibernate.SqlServerUnicodeDialect"/>
        <variable name="hibernate.dialect" condition="DBMS.Oracle"
            value="org.hibernate.dialect.OracleDialect"/>
        <variable name="datasource" condition="DBMS.H2"
            value="ExampleDS"/>
        <variable name="datasource" condition="DBMS.PostgreSQL"
            value="PostgreDS"/>
        <variable name="datasource" condition="DBMS.MSSQL"
            value="java:/mssqlds"/>
        <variable name="datasource" condition="DBMS.Oracle"
            value="OracleDS"/>
        <variable name="jndi.name" condition="!DBMS.MSSQL"
            value="java:jboss/datasources/$datasource"/>
        <variable name="jndi.name" condition="DBMS.MSSQL"
            value="$datasource"/>
        <variable name="pool.name" condition="!DBMS.MSSQL"
            value="$datasource"/>
        <variable name="pool.name" condition="DBMS.MSSQL"
            value="${datasource}_Pool"/>
        <variable name="driver.name" condition="DBMS.H2"
            value="h2"/>
        <variable name="driver.name" condition="DBMS.PostgreSQL"
            value="postgresql"/>
        <variable name="driver.name" condition="DBMS.MSSQL"
            value="sqlserver"/>
        <variable name="driver.name" condition="DBMS.Oracle"
            value="oracle"/>
        <variable name="connection.url" condition="DBMS.H2"
            value="$driver.name:${jboss.server.data.dir}/h2/localDB;DB_CLOSE_DELAY=-1;mvcc=true;DB_CLOSE_ON_EXIT=FALSE"/>
        <!-- Здесь ${jboss.server.data.dir} - переменная, которую подставляет сам jboss -->
        <variable name="connection.url" condition="DBMS.PostgreSQL"
            value="$driver.name://$DBMS.host:$DBMS.port/$DBMS.dbname"/>
        <variable name="connection.url" condition="DBMS.MSSQL"
            value="$driver.name://$DBMS.host:$DBMS.port;DatabaseName=$DBMS.dbname"/>
        <variable name="connection.url" condition="DBMS.Oracle"
            value="$driver.name:thin:@$DBMS.host:$DBMS.port:$DBMS.dbname"/>
        <variable name="min.pool.size" condition="DBMS.H2"
            value="0"/>
        <variable name="min.pool.size" condition="DBMS.PostgreSQL|DBMS.Oracle"
            value="10"/>
        <variable name="min.pool.size" condition="DBMS.MSSQL"
            value="5"/>
        <variable name="max.pool.size" condition="DBMS.H2"
            value="20"/>
        <variable name="max.pool.size" condition="DBMS.PostgreSQL|DBMS.Oracle"
            value="100"/>
        <variable name="max.pool.size" condition="DBMS.MSSQL"
            value="30"/>
        <variable name="prefill" condition="DBMS.PostgreSQL|DBMS.Oracle"
            value="true"/>
        <variable name="prefill" condition="DBMS.H2|DBMS.MSSQL"
            value="false"/>
        <variable name="DBMS.user" condition="DBMS.H2"
            value="sa"/>
        <variable name="DBMS.password" condition="DBMS.H2"
            value="sa"/>
        <variable name="DBMS.user" condition="!DBMS.H2"
            value=""/>
        <variable name="DBMS.password" condition="!DBMS.H2"
            value=""/>
        <variable name="prepared.statement.cache.size" condition="!DBMS.H2"
            value="32"/>
        <variable name="prepared.statement.cache.size" condition="DBMS.H2"
            value="10"/>
        <variable name="share.prepared.statements" condition="DBMS.PostgreSQL|DBMS.Oracle"
            value="true"/>
        <variable name="share.prepared.statements" condition="DBMS.H2|DBMS.MSSQL"
            value="false"/>
        <variable name="validation" condition="!DBMS.Oracle"
            value=""/>
        <variable name="validation" condition="DBMS.Oracle"
            value="&lt;exception-sorter class-name=&quot;org.jboss.resource.adapter.jdbc.vendor.OracleExceptionSorter&quot;/&gt;"/>
        <variable name="blocking.timeout.millis" condition="!DBMS.Oracle"
            value="30000"/>
        <variable name="blocking.timeout.millis" condition="DBMS.Oracle"
            value="5000"/>
        <variable name="idle.timeout.minutes" condition="!DBMS.Oracle"
            value="15"/>
        <variable name="idle.timeout.minutes" condition="DBMS.Oracle"
            value="5"/>
        <variable name="module" condition="DBMS.H2"
            value="com.h2database.h2"/>
        <variable name="module" condition="DBMS.PostgreSQL"
            value="org.postgresql"/>
        <variable name="module" condition="DBMS.MSSQL"
            value="com.microsoft.sqlserver"/>
        <variable name="module" condition="DBMS.Oracle"
            value="com.oraclejdbc"/>
        <variable name="xa.datasource.class" condition="DBMS.H2"
            value="org.h2.jdbcx.JdbcDataSource"/>
        <variable name="xa.datasource.class" condition="DBMS.PostgreSQL"
            value="org.postgresql.xa.PGXADataSource"/>
        <variable name="xa.datasource.class" condition="DBMS.MSSQL"
            value="com.microsoft.sqlserver.jdbc.SQLServerXADataSource"/>
        <variable name="xa.datasource.class" condition="DBMS.Oracle"
            value="oracle.jdbc.driver.OracleDriver"/>
        <variable name="java.path" value="$INSTALL_PATH$FILE_SEPARATOR$java.subpath"/>
        <variable name="arch" value="${SYSTEM[os.arch]}" checkonce="true"/>
        <variable name="webkit.installed" checkonce="true"
            executable="ldconfig"
            type="process"
            condition="izpack.linuxinstall">
            <arg>-p</arg>
            <filters>
                <regex regexp=".*libwebkit2gtk-4\.([1-9]\.so|0\.so\.(3[7-9]|[4-9][0-9])|0\.so\.[1-9][0-9]{2,}).*"
                    select="true"
                    defaultvalue="false"/>
            </filters>
        </variable>

        <variable name="gtk2.installed" checkonce="true"
            executable="ldconfig"
            type="process"
            condition="izpack.linuxinstall">
            <arg>-p</arg>
            <filters>
                <regex regexp="libgtk[-+]?2\.so\.|libgtk-x11-2\.0\.so\.|libgtk\+2\.so\."
                    select="true"
                    defaultvalue="false"/>
            </filters>
        </variable>

        <variable name="is.root" checkonce="true"
            executable="id"
            type="process"
            condition="izpack.linuxinstall">
            <arg>-u</arg>
            <filters>
                <regex regexp="^0$"
                    select="true"
                    defaultvalue="false"/>
            </filters>
        </variable>

        <variable name="user.home" checkonce="true"
            executable="sh"
            type="process"
            condition="izpack.linuxinstall">
            <arg>-c</arg>
            <arg>printf "%s" "$(getent passwd "${SUDO_USER:-$USER}" | cut -d: -f6)"</arg>
            <filters>
                <regex regexp="[\r\n]+$" replace="" global="true"/>
            </filters>
        </variable>

        <variable name="user.home" checkonce="true"
            value="$USER_HOME"
            condition="izpack.windowsinstall">
        </variable>

        <variable name="gpd.launcher.library" condition="izpack.windowsinstall" checkonce="true"
            value="plugins/org.eclipse.equinox.launcher.win32.win32.x86_64_1.2.700.v20221108-1024"/>
        <variable name="gpd.launcher.library" condition="izpack.linuxinstall" checkonce="true"
            value="plugins/org.eclipse.equinox.launcher.gtk.linux.x86_64_1.2.700.v20221108-1024"/>
        <variable name="java.executable" condition="izpack.windowsinstall"
            value="${java.path}\bin\javaw.exe"/>
        <variable name="java.executable" condition="izpack.linuxinstall"
            value="${java.path}/bin/java"/>
        <variable name="xdg.config.home" environment="XDG_CONFIG_HOME" checkonce="true"/>
        <variable name="xdg.data.home" environment="XDG_DATA_HOME" checkonce="true"/>
        <variable name="rtn.properties.path"
            condition="xdg.config.home.exists">
            <value>${xdg.config.home}/.config/@rtn.appname/settings.properties</value>
        </variable>
        <variable name="rtn.properties.path"
            condition="@izpack.linuxinstall &amp;&amp; !xdg.config.home.exists">
            <value>${user.home}/.config/@rtn.appname/settings.properties</value>
        </variable>
        <variable name="rtn.properties.path"
            condition="izpack.windowsinstall">
            <value>$local.appdata\@rtn.appname\settings.properties</value>
        </variable>
        <variable name="gpd.host" value="localhost" checkonce="true"/>
        <variable name="gpd.host" value="$server.host"
            condition="server.host.exists+!izpack.selected.RunaWFE симулятор"/>
        <variable name="gpd.port" value="8080" checkonce="true"/>
        <variable name="gpd.port" value="$server.web.port"
            condition="server.host.exists+!izpack.selected.RunaWFE симулятор"/>
        <variable name="gpd.port" value="$jboss.http.port" condition="izpack.selected.RunaWFE симулятор"/>
        <variable name="gpd.protocol" value="http" checkonce="true"/>
        <variable name="gpd.protocol" value="$server.web.protocol"
            condition="server.host.exists+!izpack.selected.RunaWFE симулятор"/>
        <variable name="securitycheck" condition="izpack.selected.Ссылки для входа"
            value="false"/>
        <variable name="securitycheck" condition="!izpack.selected.Ссылки для входа"
            value="true"/>
        <variable name="server.web.port" value="$server.web.port.auto"
            condition="server.web.port.manual.isempty">
            <filters>
                <regex regexp="^(\d+)\|.*$" select="\1" defaultvalue="8080"/>
            </filters>
        </variable>
        <variable name="server.web.port" value="$server.web.port.manual"
            condition="!server.web.port.manual.isempty"/>
        <variable name="server.web.protocol" value="$server.web.port.auto"
            condition="server.web.port.manual.isempty">
            <filters>
                <regex regexp="^\d+\|(.*)$" select="\1" defaultvalue="http"/>
            </filters>
        </variable>
        <variable name="server.web.protocol" value="https"
            condition="!server.web.port.manual.isempty"/>
    </dynamicvariables>

    <conditions>
        <condition type="exists" id="install.path.set">
            <variable>
                INSTALL_PATH
            </variable>
        </condition>

        <condition type="compareversions" id="is.downgrade">
            <arg1>${installed.version}</arg1>
            <arg2>${WFE.version}</arg2>
            <operator>gt</operator>
        </condition>

        <condition type="not" id="conditionvalidator.not.downgrade">
            <condition type="ref" refid="is.downgrade"/>
        </condition>

        <condition type="or" id="conditionvalidator.components.selected">
            <condition type="ref" refid="izpack.selected.RunaWFE сервер"/>
            <condition type="ref" refid="izpack.selected.RunaWFE симулятор"/>
            <condition type="ref" refid="izpack.selected.Демо-конфигурация"/>
            <condition type="ref" refid="izpack.selected.Среда разработки"/>
            <condition type="ref" refid="izpack.selected.Оповещатель задач"/>
            <condition type="ref" refid="izpack.selected.Ярлык веб-интерфейса RunaWFE сервера"/>
        </condition>

        <condition type="variable" id="DBMS.H2">
            <name>DBMS.type</name>
            <value>H2</value>
        </condition>
        <condition type="variable" id="DBMS.PostgreSQL">
            <name>DBMS.type</name>
            <value>PostgreSQL</value>
        </condition>
        <condition type="variable" id="DBMS.MSSQL">
            <name>DBMS.type</name>
            <value>MSSQL</value>
        </condition>
        <condition type="variable" id="DBMS.Oracle">
            <name>DBMS.type</name>
            <value>Oracle</value>
        </condition>

        <condition type="variable" id="Usertype.Administrator">
            <name>INSTALL_GROUP</name>
            <value>Администратор</value>
        </condition>
        <condition type="variable" id="Usertype.User">
            <name>INSTALL_GROUP</name>
            <value>Пользователь</value>
        </condition>
        <!-- workaround для preselect студии -->
        <condition type="and" id="Usertype.Analyst">
            <condition type="ref" refid="!Usertype.Administrator"/>
            <condition type="ref" refid="!Usertype.User"/>
        </condition>
        <condition type="exists" id="simulator.db.exists">
            <file>$appdata.install.path\jboss\data\h2\localDB.mv.db</file>
        </condition>

        <condition type="variable" id="x86_64">
            <name>arch</name>
            <value>x86_64</value>
        </condition>
        <condition type="variable" id="amd64">
            <name>arch</name>
            <value>amd64</value>
        </condition>
        <condition type="variable" id="aarch64">
            <name>arch</name>
            <value>aarch64</value>
        </condition>
        <condition type="variable" id="webkit.installed">
            <name>webkit.installed</name>
            <value>true</value>
        </condition>
        <condition type="variable" id="gtk2.installed">
            <name>gtk2.installed</name>
            <value>true</value>
        </condition>
        <condition type="variable" id="is.root">
            <name>is.root</name>
            <value>true</value>
        </condition>
        <condition type="exists" id="xdg.config.home.exists">
            <variable>xdg.config.home</variable>
        </condition>
        <condition type="exists" id="xdg.data.home.exists">
            <variable>xdg.data.home</variable>
        </condition>
        <condition type="exists" id="server.host.exists">
            <variable>server.host</variable>
        </condition>
        <condition type="comparenumerics" id="port.management.http.changed">
            <arg1>${default.jboss.management.http.port}</arg1>
            <arg2>${jboss.management.http.port}</arg2>
            <operator>ne</operator>
        </condition>
        <condition type="comparenumerics" id="port.management.https.changed">
            <arg1>${default.jboss.management.https.port}</arg1>
            <arg2>${jboss.management.https.port}</arg2>
            <operator>ne</operator>
        </condition>
        <condition type="comparenumerics" id="port.ajp.changed">
            <arg1>${default.jboss.ajp.port}</arg1>
            <arg2>${jboss.ajp.port}</arg2>
            <operator>ne</operator>
        </condition>
        <condition type="comparenumerics" id="port.http.changed">
            <arg1>${default.jboss.http.port}</arg1>
            <arg2>${jboss.http.port}</arg2>
            <operator>ne</operator>
        </condition>
        <condition type="comparenumerics" id="port.https.changed">
            <arg1>${default.jboss.https.port}</arg1>
            <arg2>${jboss.https.port}</arg2>
            <operator>ne</operator>
        </condition>
        <condition type="comparenumerics" id="port.iiop.changed">
            <arg1>${default.jboss.iiop.port}</arg1>
            <arg2>${jboss.iiop.port}</arg2>
            <operator>ne</operator>
        </condition>
        <condition type="comparenumerics" id="port.iiop-ssl.changed">
            <arg1>${default.jboss.iiop-ssl.port}</arg1>
            <arg2>${jboss.iiop-ssl.port}</arg2>
            <operator>ne</operator>
        </condition>
        <condition type="comparenumerics" id="port.txn-recovery.changed">
            <arg1>${default.jboss.txn-recovery-environment.port}</arg1>
            <arg2>${jboss.txn-recovery-environment.port}</arg2>
            <operator>ne</operator>
        </condition>
        <condition type="comparenumerics" id="port.txn-status.changed">
            <arg1>${default.jboss.txn-status-manager.port}</arg1>
            <arg2>${jboss.txn-status-manager.port}</arg2>
            <operator>ne</operator>
        </condition>
        <condition type="or" id="any.port.changed">
            <condition type="ref" refid="port.management.http.changed"/>
            <condition type="ref" refid="port.management.https.changed"/>
            <condition type="ref" refid="port.ajp.changed"/>
            <condition type="ref" refid="port.http.changed"/>
            <condition type="ref" refid="port.https.changed"/>
            <condition type="ref" refid="port.iiop.changed"/>
            <condition type="ref" refid="port.iiop-ssl.changed"/>
            <condition type="ref" refid="port.txn-recovery.changed"/>
            <condition type="ref" refid="port.txn-status.changed"/>
        </condition>
        <condition type="empty" id="server.web.port.manual.isempty">
            <variable>server.web.port.manual</variable>
        </condition>
    </conditions>

    <panels>
        <panel classname="HelloPanel"/>
        <panel classname="HTMLLicencePanel" id="license" condition="izpack.gui.installer"/>
        <panel classname="LicencePanel" id="license_txt" condition="izpack.console.installer">
            <configuration>
                <param name="console-text-wordwrap" value="true"/>
            </configuration>
        </panel>
        <panel classname="InstallationGroupPanel"/>
        <panel classname="TreePacksPanel">
            <validator classname="com.izforge.izpack.installer.validator.ConditionValidator"/>
        </panel>
        <panel classname="UserInputPanel" id="panel.webkit.warn" condition="izpack.linuxinstall+!webkit.installed"/>
        <panel classname="UserInputPanel" id="panel.gtk.warn" condition="izpack.linuxinstall+!gtk2.installed"/>
        <panel classname="UserInputPanel" id="panel.database.connection"/>
        <panel classname="UserInputPanel" id="panel.wildfly.connection"/>
        <panel classname="UserInputPanel" id="panel.server.web.interface"/>
        <panel classname="TargetPanel">
            <validator classname="com.izforge.izpack.installer.validator.ConditionValidator"/>
        </panel>
        <panel classname="UserInputPanel" id="panel.port.changed.info" condition="any.port.changed"/>
        <panel classname="InstallPanel"/>
        <panel classname="ShortcutPanel"/>
        <panel classname="ProcessPanel"/>
        <panel classname="InfoPanel" condition="izpack.selected.RunaWFE сервер+izpack.windowsinstall" allowClose="false"/>
        <panel classname="SimpleFinishPanel"/>
    </panels>

    <packs>
        <refpack file="packs_@{ENV[TARGET_OS]}.xml"/>
    </packs>

</izpack:installation>