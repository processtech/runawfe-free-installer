<?xml version="1.0" encoding="UTF-8"?>
<izpack:processing version="5.0"
    xmlns:izpack="http://izpack.org/schema/processing" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://izpack.org/schema/processing http://izpack.org/schema/5.0/izpack-processing-5.0.xsd">

    <job name="Copy JRE Windows">
        <os family="windows"/>
        <executefile name="cmd">
            <arg>/c</arg>
            <arg><![CDATA[ xcopy "${JAVA_HOME}\*.*" "$java.path" /E /I /Y /Q >nul 2>&1 ]]></arg>
        </executefile>
    </job>

    <job name="Copy JRE Linux">
        <os family="unix"/>
        <executefile name="sh">
            <arg>-c</arg>
            <arg><![CDATA[mkdir -p "$java.path" && cp -Rp "${JAVA_HOME}/"* "$java.path/"]]></arg>
        </executefile>
    </job>

    <job name="Set executable permissions for shell scripts" condition="izpack.selected.RunaWFE симулятор|izpack.selected.RunaWFE сервер">
        <os family="unix"/>
        <executefile name="sh">
            <arg>-c</arg>
            <arg><![CDATA[chmod +x "$INSTALL_PATH/$appserver.subpath/bin/"*.sh 2>/dev/null; chmod +x "$INSTALL_PATH/$simulator.subpath/bin/"*.sh 2>/dev/null]]></arg>
        </executefile>
    </job>

    <job name="Add notifier to autostart" condition="izpack.selected.Оповещатель задач">
        <os family="unix"/>
        <executefile name="sh">
            <arg>-c</arg>
            <arg><![CDATA[if [ -f "/usr/share/applications/Task notifier.desktop" ]; then
    mkdir -p /etc/xdg/autostart
    cp "/usr/share/applications/Task notifier.desktop" /etc/xdg/autostart/
fi]]></arg>
        </executefile>
    </job>

    <job name="Add server to autostart">
        <os family="unix"/>
        <executeForPack name="RunaWFE сервер"/>
        <executefile name="$INSTALL_PATH/$appserver.subpath/init_systemd.sh"/>
    </job>
    <onSuccess previous="false" next="true"/>

</izpack:processing>