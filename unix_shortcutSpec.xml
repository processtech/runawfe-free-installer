<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<izpack:shortcuts version="5.0"
    xmlns:izpack="http://izpack.org/schema/shortcuts"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://izpack.org/schema/shortcuts http://izpack.org/schema/5.0/izpack-shortcuts-5.0.xsd">

    <programGroup defaultName="$APP_NAME $APP_VER"/>

    <shortcut name="Developer studio" target="$INSTALL_PATH/$gpd.subpath/runa-gpd"
        workingDirectory="$INSTALL_PATH/$gpd.subpath"
        type="Application"
        createForAll="true"
        categories="Office;Development"
        encoding="UTF-8"
        commandLine="-data &quot;$appdata.install.path/$gpd.subpath/workspace&quot;"
        programGroup="true"
        desktop="true" iconFile="$INSTALL_PATH/$images.subpath/D_20x20_256.png"
        description="Среда разработки - приложение, предназначенное для разработки процессов системы RunaWFE Free">
        <createForPack name="Среда разработки"/>
    </shortcut>

</izpack:shortcuts>