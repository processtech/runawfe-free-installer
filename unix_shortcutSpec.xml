<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<izpack:shortcuts version="5.0"
    xmlns:izpack="http://izpack.org/schema/shortcuts"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://izpack.org/schema/shortcuts http://izpack.org/schema/5.0/izpack-shortcuts-5.0.xsd">

    <programGroup defaultName="$APP_NAME $APP_VER"/>

    <shortcut name="Developer studio" target="$INSTALL_PATH/$gpd.subpath/start.sh"
        workingDirectory="$INSTALL_PATH/$gpd.subpath"
        type="Application"
        createForAll="true"
        categories="Office;Development"
        encoding="UTF-8"
        programGroup="true"
        iconFile="$INSTALL_PATH/$images.subpath/D_20x20_256.png"
        description="Среда разработки - приложение, предназначенное для разработки процессов системы RunaWFE">
        <createForPack name="Среда разработки"/>
    </shortcut>

    <shortcut name="Task notifier" target="$INSTALL_PATH/$rtn.subpath/start.sh"
        workingDirectory="$INSTALL_PATH/$rtn.subpath"
        type="Application"
        createForAll="true"
        categories="Office;Development"
        encoding="UTF-8"
        programGroup="true"
        terminal="false"
        iconFile="$INSTALL_PATH/$images.subpath/t_20x20_256.png"
        description="Оповещатель задачи - приложение, предназначенное для автоматической проверки новых задач пользователя">
        <createForPack name="Оповещатель задач"/>
    </shortcut>

    <shortcut name="Server web interface"
        target="xdg-open http://${server.host}:${server.web.port}/wfe/"
        type="Application"
        createForAll="true"
        categories="Office;Development"
        encoding="UTF-8"
        programGroup="true"
        terminal="false"
        iconFile="$INSTALL_PATH/$images.subpath/C_20x20_256.png"
        description="Запуск веб-интерфейса основного RunaWFE сервера">
        <createForPack name="Ярлык веб-интерфейса RunaWFE сервера"/>
    </shortcut>

    <shortcut name="Simulator web interface"
        target="xdg-open http://localhost:${jboss.http.port}/wfe/"
        type="Application"
        createForAll="true"
        categories="Office;Development"
        encoding="UTF-8"
        programGroup="true"
        terminal="false"
        iconFile="$INSTALL_PATH/$images.subpath/Si_20x20_256.png"
        description="Запуск веб-интерфейса сервера-симулятора">
        <createForPack name="RunaWFE симулятор"/>
    </shortcut>

    <shortcut name="Start simulation"
        target="$INSTALL_PATH/$simulator.subpath/bin/run_simulation.sh"
        workingDirectory="$INSTALL_PATH/$simulator.subpath/bin"
        type="Application"
        createForAll="true"
        categories="Office;Development"
        encoding="UTF-8"
        programGroup="true"
        terminal="true"
        iconFile="$INSTALL_PATH/$images.subpath/Si_20x20_256.png"
        description="Запуск тестового сервера-симулятора RunaWFE">
        <createForPack name="RunaWFE симулятор"/>
    </shortcut>

    <shortcut name="Stop simulation"
        target="$INSTALL_PATH/$simulator.subpath/bin/stop_simulation.sh"
        workingDirectory="$INSTALL_PATH/$simulator.subpath/bin"
        type="Application"
        createForAll="true"
        categories="Office;Development"
        encoding="UTF-8"
        programGroup="true"
        terminal="true"
        iconFile="$INSTALL_PATH/$images.subpath/Si_20x20_256.png"
        description="Остановка тестового сервера-симулятора RunaWFE">
        <createForPack name="RunaWFE симулятор"/>
    </shortcut>

</izpack:shortcuts>