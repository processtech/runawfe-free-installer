<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<izpack:shortcuts version="5.0"
    xmlns:izpack="http://izpack.org/schema/shortcuts"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://izpack.org/schema/shortcuts http://izpack.org/schema/5.0/izpack-shortcuts-5.0.xsd">
    <defaultCurrentUser/>

    <programGroup defaultName="$APP_NAME $APP_VER"/>

    <shortcut name="Developer studio" target="$INSTALL_PATH\$gpd.subpath\runa-gpd.exe"
        workingDirectory="$INSTALL_PATH\$gpd.subpath"
        commandLine="-data $appdata\$APP_NAME\$gpd.subpath\workspace"
        programGroup="true"
        desktop="true" iconFile="$INSTALL_PATH\$images.subpath\e_20x20_256.ico"
        description="Среда разработки - приложение, предназначенное для разработки процессов системы RunaWFE Free">
        <createForPack name="Среда разработки"/>
    </shortcut>

    <shortcut name="Task notifier" target="$INSTALL_PATH\$rtn.subpath\rtn.bat"
        workingDirectory="$INSTALL_PATH\$rtn.subpath"
        programGroup="true"
        desktop="true" startup="true" iconFile="$INSTALL_PATH\$images.subpath\t_20x20_256.ico"
        description="Оповещатель задачи - приложение, предназначенное для автоматической проверки новых задач пользователя">
        <createForPack name="Оповещаетель задач"/>
    </shortcut>

    <shortcut name="Server web interface" target="$INSTALL_PATH/$web.interface.subpath/runawfe.html"
        programGroup="true"
        desktop="true" iconFile="$INSTALL_PATH\$images.subpath\C_20x20_256.ico"
        description="Запуск веб-интерфейса основного RunaWFE сервера">
        <createForPack name="Ярлык веб-интерфейса RunaWFE сервера"/>
    </shortcut>

    <shortcut name="Simulator web interface"
        target="$INSTALL_PATH/${simulator.subpath}/simulator.html"
        programGroup="true"
        desktop="true" iconFile="$INSTALL_PATH\$images.subpath\Si_20x20_256.ico"
        description="Запуск веб-интерфейса сервера-симулятора">
        <createForPack name="RunaWFE симулятор"/>
    </shortcut>

    <shortcut name="Start simulation"
        target="$INSTALL_PATH\$simulator.subpath\bin\run_simulaton.bat"
        workingDirectory="$INSTALL_PATH\$simulator.subpath\bin"
        programGroup="true"
        desktop="true" iconFile="$INSTALL_PATH\$images.subpath\Si_20x20_256.ico"
        description="Запуск тестового сервера-симулятора RunaWFE">
        <createForPack name="RunaWFE симулятор"/>
    </shortcut>

    <shortcut name="Stop simulation"
        target="$INSTALL_PATH/${simulator.subpath}/bin/jboss-cli.bat"
        commandLine="--connect --controller=localhost:$jboss.management.http.port --command=:shutdown"
        initialState="noShow"
        programGroup="true"
        desktop="true" iconFile="$INSTALL_PATH\$images.subpath\Si_20x20_256.ico"
        description="Остановка тестового сервера-симулятора RunaWFE">
        <createForPack name="RunaWFE симулятор"/>
    </shortcut>

    <shortcut name="Uninstall" target="$INSTALL_PATH\Uninstaller\uninstall.bat"
        initialState="noShow"
        programGroup="true"
        iconFile="$INSTALL_PATH\$images.subpath\wf_48x128.ico" runAsAdministrator="true"
        description="Деинсталляция продуктов RunaWFE">
    </shortcut>

</izpack:shortcuts>