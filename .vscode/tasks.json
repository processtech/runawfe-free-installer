{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "IzPack: Build",
            "type": "shell",
            "command": "build.bat ${input:platformSelect}",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": {
                "owner": "izpack",
                "fileLocation": "relative",
                "severity": "error",
                "pattern": {
                    "regexp": "file:///(?:.*/|.*\\\\)([^/\\\\]+\\.xml).*?\\(Line\\s+(\\d+),\\s+Column\\s+(\\d+)\\)\\s*([^\\r\\n]+)",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "message": 4
                }
            }
        },
        {
            "label": "Create installer.run (Linux)",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "wrappers\\izpack2run\\build_linux.cmd"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Convert to EXE",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "wrappers\\izpack2exe\\build_exe.cmd"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Run EXE Installer",
            "type": "shell",
            "command": "run-exe-installer.cmd",
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Allow X11 Access for docker",
            "type": "shell",
            "command": "wsl",
            "args": [
                "xhost",
                "+local:docker"
            ],
            "presentation": {
                "reveal": "silent",
                "close": true
            }
        },
        {
            "label": "Prepare for target OS",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "prepare_for_target_os.cmd",
                "${input:serviceSelect}"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Run on target OS",
            "dependsOn": [
                "Allow X11 Access for docker",
                "Prepare for target OS"
            ],
            "type": "shell",
            "command": "wsl",
            "args": [
                "docker-compose",
                "-f",
                "docker/docker-compose.yml",
                "run",
                "--rm",
                "--build",
                "--service-ports",
                "${input:serviceSelect}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "⏱️ ЗАМЕР: Полная сборка и запуск",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/benchmark.ps1",
                "${input:serviceSelect}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "serviceSelect",
            "type": "pickString",
            "description": "Выберите систему для отладки",
            "options": [
                "astra17-gui",
                "astra17-console",
                "astra18-gui",
                "astra18-console",
                "altp10-gui",
                "altp10-console",
                "altp11-gui",
                "altp11-console",
                "redos8-gui",
                "redos8-console",
                "macos-vm",
                "win7-vm",
                "altp10-vm"
            ]
        },
        {
            "id": "platformSelect",
            "type": "pickString",
            "description": "Выберите целевую платформу",
            "options": [
                "windows x86_64",
                "linux x86_64",
                "linux aarch64",
                "macos x86_64"
            ]
        }
    ]
}