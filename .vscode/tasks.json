{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "IzPack: Build",
            "type": "shell",
            "command": "build.bat",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": {
                "owner": "izpack",
                "fileLocation": "relative",
                "severity": "error",
                "pattern": {
                    "regexp": "file:///(?:.*/|.*\\\\)([^/\\\\]+\\.xml).*?\\(Line\\s+(\\d+),\\s+Column\\s+(\\d+)\\)\\s*([^\\r\\n]+)",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "message": 4
                }
            }
        },
        {
            "label": "Run jar in Windows",
            "type": "shell",
            "command": "run-installer.bat",
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Convert to EXE",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "wrappers\\build_exe.cmd"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Run EXE Installer",
            "type": "shell",
            "command": "run-exe-installer.cmd",
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Create docker image for Linux console",
            "type": "shell",
            "command": "docker",
            "args": [
                "build",
                "-f",
                "docker/Dockerfile.ubuntu-java",
                "-t",
                "linux-for-izpack",
                "."
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Run jar in Linux console",
            "type": "shell",
            "command": "docker",
            "args": [
                "run",
                "--rm",
                "-it",
                "-v",
                "${workspaceFolder}/install.jar:/installer/install.jar:ro",
                "linux-for-izpack",
                "java",
                "-Dfile.encoding=UTF-8",
                "-jar",
                "/installer/install.jar"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Create docker image for Linux GUI",
            "type": "shell",
            "command": "docker",
            "args": [
                "build",
                "-f",
                "docker/Dockerfile.ubuntu-java-wsl",
                "-t",
                "linux-for-izpack-wsl",
                "."
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Run jar in Linux GUI",
            "dependsOn": "Allow X11 Access for docker",
            "type": "shell",
            "command": "wsl",
            "args": [
                "docker",
                "run",
                "--rm",
                "-it",
                "-v",
                "/tmp/.X11-unix:/tmp/.X11-unix",
                "-v",
                "/mnt/wslg:/mnt/wslg",
                "-e",
                "DISPLAY=:0",
                "-e",
                "WAYLAND_DISPLAY=wayland-0",
                "-e",
                "XDG_RUNTIME_DIR=/mnt/wslg/runtime-dir",
                "-e",
                "QT_X11_NO_MITSHM=1",
                "-v",
                "$(wslpath '${workspaceFolder}')/install.jar:/installer/install.jar:ro",
                "linux-for-izpack-wsl",
                "java",
                "-jar",
                "/installer/install.jar"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Allow X11 Access for docker",
            "type": "shell",
            "command": "wsl",
            "args": [
                "xhost",
                "+local:docker"
            ],
            "presentation": {
                "reveal": "silent", // Не открывать терминал, если всё ок
                "close": true
            }
        }
    ]
}