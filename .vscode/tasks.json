{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "IzPack: Build",
            "type": "shell",
            "command": "build.bat",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": {
                "owner": "izpack",
                "fileLocation": "relative",
                "severity": "error",
                "pattern": {
                    "regexp": "file:///(?:.*/|.*\\\\)([^/\\\\]+\\.xml).*?\\(Line\\s+(\\d+),\\s+Column\\s+(\\d+)\\)\\s*([^\\r\\n]+)",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "message": 4
                }
            },
            "detail": "Компилирует RunaWFE_installer.xml → install.jar"
        },
        {
            "label": "IzPack: Run Installer",
            "type": "shell",
            "command": "run-installer.bat",
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "detail": "Запускает install.jar (если файл существует)"
        },
        {
            "label": "IzPack: Convert to EXE",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "wrappers\\build_exe.cmd"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "detail": "Конвертирует jar в exe"
        },
        {
            "label": "IzPack: Run EXE Installer",
            "type": "shell",
            "command": "run-exe-installer.cmd",
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "detail": "Запускает EXE установщик"
        }
    ]
}