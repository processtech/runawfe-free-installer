{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "IzPack: Build",
            "type": "shell",
            "command": "build.bat",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": {
                "owner": "izpack",
                "fileLocation": "relative",
                "severity": "error",
                "pattern": {
                    "regexp": "file:///(?:.*/|.*\\\\)([^/\\\\]+\\.xml).*?\\(Line\\s+(\\d+),\\s+Column\\s+(\\d+)\\)\\s*([^\\r\\n]+)",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "message": 4
                }
            }
        },
        {
            "label": "Run jar in Windows",
            "type": "shell",
            "command": "run-installer.bat",
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Convert to EXE",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "wrappers\\izpack2exe\\build_exe.cmd"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Run EXE Installer",
            "type": "shell",
            "command": "run-exe-installer.cmd",
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Create docker image for Linux console",
            "type": "shell",
            "command": "docker",
            "args": [
                "build",
                "-f",
                "docker/Dockerfile.ubuntu-java",
                "-t",
                "linux-for-izpack",
                "."
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Run jar in Linux console",
            "type": "shell",
            "command": "docker",
            "args": [
                "run",
                "--rm",
                "-it",
                "-v",
                "${workspaceFolder}/install.jar:/installer/install.jar:ro",
                "linux-for-izpack",
                "java",
                "-Dfile.encoding=UTF-8",
                "-jar",
                "/installer/install.jar"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Allow X11 Access for docker",
            "type": "shell",
            "command": "wsl",
            "args": [
                "xhost",
                "+local:docker"
            ],
            "presentation": {
                "reveal": "silent", // Не открывать терминал, если всё ок
                "close": true
            }
        },
        {
            "label": "Run on target OS",
            "dependsOn": "Allow X11 Access for docker",
            "type": "shell",
            "command": "wsl",
            "args": [
                "docker-compose",
                "-f",
                "docker/docker-compose.yml",
                "run",
                "--rm",
                "--service-ports",
                "${input:serviceSelect}" // Выбор из списка
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "serviceSelect",
            "type": "pickString",
            "description": "Выберите систему для отладки",
            "options": [
                "astra17-gui",
                "astra17-console",
                "astra18-gui",
                "astra18-console",
                "altp10-gui",
                "altp10-console",
                "altp11-gui",
                "altp11-console",
                "redos8-gui",
                "redos8-console",
                "macos-gui",
                "win7-gui"
            ]
        }
    ]
}