{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "IzPack: Build & Run Installer",
            "type": "shell",
            "command": ".\\build-and-run.bat",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": {
                "owner": "izpack",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": [
                    {
                        // Ловим: file:///.../file.xml (Line 17, Column 12) cvc-...: ...
                        "regexp": "file:///(?:.*/|.*\\\\)([a-zA-Z0-9_\\-]+\\.xml).*?\\(Line\\s+(\\d+),\\s+Column\\s+(\\d+)\\)\\s*(.+)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "message": 4
                    },
                    {
                        // Ловим: Error in C:\...\file.xml at line 17, column 12 : ...
                        "regexp": "Error in .*(?:\\\\|/)([a-zA-Z0-9_\\-]+\\.xml).*?at line\\s+(\\d+),\\s+column\\s+(\\d+)\\s*:\\s*(.+)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "message": 4
                    }
                ]
            },
            "detail": "Компилирует RunaWFE_installer.xml → install.jar и запускает его",
            "runOptions": {
                "reevaluateOnRerun": true
            }
        }
    ]
}