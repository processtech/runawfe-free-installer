{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "IzPack: Build",
            "type": "shell",
            "command": "build.bat",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": {
                "owner": "izpack",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": [
                    {
                        "regexp": "file:///(?:.*/|.*\\\\)([a-zA-Z0-9_\\-]+\\.xml).*?\\(Line\\s+(\\d+),\\s+Column\\s+(\\d+)\\)\\s*(.+)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "message": 4
                    },
                    {
                        "regexp": "Error in .*(?:\\\\|/)([a-zA-Z0-9_\\-]+\\.xml).*?at line\\s+(\\d+),\\s+column\\s+(\\d+)\\s*:\\s*(.+)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "message": 4
                    }
                ]
            },
            "detail": "Компилирует RunaWFE_installer.xml → install.jar"
        },
        {
            "label": "IzPack: Run Installer",
            "type": "shell",
            "command": "run-installer.bat",
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "detail": "Запускает install.jar (если файл существует)"
        }
    ]
}
